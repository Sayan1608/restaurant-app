# Local PostgreSQL container settings. Defaults are for local development only.
POSTGRES_DB=restaurant_app
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Backend datasource when running the application outside Docker.
DATABASE_URL=jdbc:postgresql://localhost:5433/restaurant_app
DATABASE_USERNAME=restaurant_app
DATABASE_PASSWORD=replace-with-the-same-local-password

# Frontend API URL. Copy frontend/.env.example to frontend/.env.local when needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional server-side menu FAQ assistant configuration. Keep the key server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional SMTP configuration for email OTP password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=noreply@restaurant.local
